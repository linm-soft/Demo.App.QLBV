<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trợ giúp - QLCV Y Khoa</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="css/styles.css">
</head>
<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <i class="fas fa-hospital-user"></i>
                    <span>QLCV Y Khoa</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section">
                    <div class="nav-section-title">Menu chính</div>
                    <a href="dashboard-staff.html" class="nav-item">
                        <i class="fas fa-chart-pie"></i>
                        <span>Bảng điều khiển</span>
                    </a>
                    <a href="tickets-list.html" class="nav-item">
                        <i class="fas fa-ticket-alt"></i>
                        <span>Phiếu yêu cầu</span>
                    </a>
                    <a href="tasks-list.html" class="nav-item">
                        <i class="fas fa-tasks"></i>
                        <span>Công việc của tôi</span>
                    </a>
                    <a href="task-pool.html" class="nav-item">
                        <i class="fas fa-swimming-pool"></i>
                        <span>Công việc chờ nhận</span>
                    </a>
                </div>

                <div class="nav-section">
                    <div class="nav-section-title">Khác</div>
                    <a href="settings.html" class="nav-item">
                        <i class="fas fa-cog"></i>
                        <span>Cài đặt</span>
                    </a>
                    <a href="help.html" class="nav-item active">
                        <i class="fas fa-question-circle"></i>
                        <span>Trợ giúp</span>
                    </a>
                </div>
            </nav>

            <div class="sidebar-footer">
                <div class="user-profile">
                    <div class="user-avatar">NVA</div>
                    <div class="user-info">
                        <div class="user-name">Nguyễn Văn A</div>
                        <div class="user-role">Nhân viên</div>
                    </div>
                </div>
                <div class="logout-btn">
                    <a href="login.html" style="color: var(--gray-500); margin-left: auto;">
                        <i class="fas fa-sign-out-alt"></i>
                    </a>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <!-- Topbar -->
            <header class="topbar">
                <div class="page-title">
                    <h1>
                        <i class="fas fa-life-ring"></i>
                        Trung tâm Trợ giúp
                    </h1>
                    <p style="color: var(--gray-500); font-size: 0.875rem; margin-top: 0.25rem;">Hướng dẫn sử dụng và giải đáp thắc mắc</p>
                </div>
            </header>

            <!-- Content Area -->
            <div class="content-area">
                <!-- Search Box -->
                <div class="card" style="margin-bottom: 2rem;">
                <div class="search-box" style="max-width: 600px; margin: 0 auto;">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Tìm kiếm hướng dẫn, câu hỏi thường gặp..." style="font-size: 1rem; padding: 0.875rem 1rem 0.875rem 3rem;">
                </div>
            </div>

            <!-- Quick Links -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
                <div class="card" style="text-align: center; cursor: pointer;" onclick="location.href='#getting-started'">
                    <div style="width: 80px; height: 80px; margin: 0 auto 1rem; background: var(--primary-light); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-rocket" style="font-size: 2rem; color: var(--primary-color);"></i>
                    </div>
                    <h3 style="margin-bottom: 0.5rem;">Bắt đầu</h3>
                    <p style="color: var(--gray-600); font-size: 0.875rem;">Hướng dẫn cơ bản cho người dùng mới</p>
                </div>
                
                <div class="card" style="text-align: center; cursor: pointer;" onclick="location.href='#guides'">
                    <div style="width: 80px; height: 80px; margin: 0 auto 1rem; background: #dcfce7; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-book" style="font-size: 2rem; color: var(--success-color);"></i>
                    </div>
                    <h3 style="margin-bottom: 0.5rem;">Hướng dẫn</h3>
                    <p style="color: var(--gray-600); font-size: 0.875rem;">Tài liệu chi tiết về các tính năng</p>
                </div>
                
                <div class="card" style="text-align: center; cursor: pointer;" onclick="location.href='#faq'">
                    <div style="width: 80px; height: 80px; margin: 0 auto 1rem; background: #fef3c7; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-question" style="font-size: 2rem; color: var(--warning-color);"></i>
                    </div>
                    <h3 style="margin-bottom: 0.5rem;">FAQ</h3>
                    <p style="color: var(--gray-600); font-size: 0.875rem;">Câu hỏi thường gặp và giải đáp</p>
                </div>
                
                <div class="card" style="text-align: center; cursor: pointer;" onclick="location.href='#contact'">
                    <div style="width: 80px; height: 80px; margin: 0 auto 1rem; background: #dbeafe; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-headset" style="font-size: 2rem; color: var(--info-color);"></i>
                    </div>
                    <h3 style="margin-bottom: 0.5rem;">Liên hệ hỗ trợ</h3>
                    <p style="color: var(--gray-600); font-size: 0.875rem;">Liên hệ với đội ngũ hỗ trợ</p>
                </div>
            </div>

            <!-- Getting Started -->
            <div id="getting-started" class="card" style="margin-bottom: 1.5rem;">
                <h2 style="margin-bottom: 1.5rem;">
                    <i class="fas fa-rocket" style="color: var(--primary-color);"></i>
                    Bắt đầu với QLCV Y Khoa
                </h2>
                <div style="display: grid; gap: 1rem;">
                    <div class="accordion-item">
                        <div class="accordion-header" onclick="toggleAccordion(this)">
                            <i class="fas fa-sign-in-alt"></i>
                            <span>Đăng nhập và thiết lập tài khoản</span>
                            <i class="fas fa-chevron-down accordion-icon"></i>
                        </div>
                        <div class="accordion-content">
                            <p><strong>Đăng nhập:</strong></p>
                            <ol style="padding-left: 1.5rem; margin-bottom: 1rem;">
                                <li>Truy cập vào trang đăng nhập</li>
                                <li>Nhập email và mật khẩu được cấp bởi IT</li>
                                <li>Chọn "Ghi nhớ đăng nhập" nếu muốn tự động đăng nhập lần sau</li>
                            </ol>
                            <p><strong>Đổi mật khẩu lần đầu:</strong></p>
                            <ol style="padding-left: 1.5rem;">
                                <li>Vào Cài đặt > Bảo mật</li>
                                <li>Chọn "Đổi mật khẩu"</li>
                                <li>Nhập mật khẩu cũ và mật khẩu mới (tối thiểu 8 ký tự, có chữ hoa, số và ký tự đặc biệt)</li>
                            </ol>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header" onclick="toggleAccordion(this)">
                            <i class="fas fa-th-large"></i>
                            <span>Tổng quan giao diện</span>
                            <i class="fas fa-chevron-down accordion-icon"></i>
                        </div>
                        <div class="accordion-content">
                            <p><strong>Sidebar bên trái:</strong> Menu điều hướng chính với các mục Phiếu yêu cầu, Công việc, Công việc chờ nhận</p>
                            <p><strong>Topbar trên cùng:</strong> Thanh tìm kiếm, thông báo và thông tin người dùng</p>
                            <p><strong>Nội dung chính:</strong> Hiển thị danh sách công việc, chi tiết và biểu mẫu</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Guides -->
            <div id="guides" class="card" style="margin-bottom: 1.5rem;">
                <h2 style="margin-bottom: 1.5rem;">
                    <i class="fas fa-book" style="color: var(--success-color);"></i>
                    Hướng dẫn sử dụng
                </h2>
                <div style="display: grid; gap: 1rem;">
                    <div class="accordion-item">
                        <div class="accordion-header" onclick="toggleAccordion(this)">
                            <i class="fas fa-ticket-alt"></i>
                            <span>Quản lý Phiếu Yêu Cầu</span>
                            <i class="fas fa-chevron-down accordion-icon"></i>
                        </div>
                        <div class="accordion-content">
                            <p><strong>Tạo Ticket mới:</strong></p>
                            <ol style="padding-left: 1.5rem; margin-bottom: 1rem;">
                                <li>Vào trang Phiếu Yêu Cầu</li>
                                <li>Nhấn nút "Tạo Ticket"</li>
                                <li>Điền thông tin: Tiêu đề, Mô tả, Mức độ ưu tiên, Loại sự cố</li>
                                <li>Đính kèm file nếu cần</li>
                                <li>Nhấn "Gửi" để tạo ticket</li>
                            </ol>
                            <p><strong>Theo dõi Ticket:</strong></p>
                            <p>Xem trạng thái, người xử lý, SLA và cập nhật mới nhất trong danh sách Phiếu Yêu Cầu hoặc trang chi tiết.</p>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header" onclick="toggleAccordion(this)">
                            <i class="fas fa-tasks"></i>
                            <span>Làm việc với Công Việc</span>
                            <i class="fas fa-chevron-down accordion-icon"></i>
                        </div>
                        <div class="accordion-content">
                            <p><strong>Nhận task:</strong></p>
                            <ul style="padding-left: 1.5rem; margin-bottom: 1rem;">
                                <li>Công việc được phân công: Hiển thị trong bảng điều khiển và danh sách Công việc</li>
                                <li>Tự nhận công việc từ Công việc chờ nhận: Vào Công việc chờ nhận, chọn công việc phù hợp và nhấn "Nhận việc"</li>
                            </ul>
                            <p><strong>Cập nhật tiến độ:</strong></p>
                            <ol style="padding-left: 1.5rem; margin-bottom: 1rem;">
                                <li>Mở task cần cập nhật</li>
                                <li>Kéo thanh Progress để cập nhật % hoàn thành</li>
                                <li>Tick checkbox cho các công việc con đã hoàn thành</li>
                                <li>Ghi nhận thời gian làm việc trong Time Logs</li>
                            </ol>
                            <p><strong>Hoàn thành công việc:</strong></p>
                            <ol style="padding-left: 1.5rem;">
                                <li>Đảm bảo tiến độ = 100%</li>
                                <li>Viết ghi chú hoàn thành</li>
                                <li>Nhấn "Hoàn thành công việc"</li>
                                <li>Công việc sẽ chuyển sang trạng thái chờ phê duyệt (nếu cần)</li>
                            </ol>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header" onclick="toggleAccordion(this)">
                            <i class="fas fa-swimming-pool"></i>
                            <span>Sử dụng Công việc chờ nhận</span>
                            <i class="fas fa-chevron-down accordion-icon"></i>
                        </div>
                        <div class="accordion-content">
                            <p><strong>Công việc chờ nhận là gì?</strong></p>
                            <p style="margin-bottom: 1rem;">Nơi tập trung các công việc chưa được phân công, nhân viên có thể tự chọn công việc phù hợp với kỹ năng và thời gian của mình.</p>
                            <p><strong>Cách chọn công việc:</strong></p>
                            <ol style="padding-left: 1.5rem;">
                                <li>Sử dụng bộ lọc để tìm công việc phù hợp (mức độ, kỹ năng, deadline)</li>
                                <li>Xem thông tin chi tiết công việc: thời gian ước tính, yêu cầu kỹ năng</li>
                                <li>Nhấn "Nhận công việc" để nhận về danh sách của bạn</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>

            <!-- FAQ -->
            <div id="faq" class="card" style="margin-bottom: 1.5rem;">
                <h2 style="margin-bottom: 1.5rem;">
                    <i class="fas fa-question-circle" style="color: var(--warning-color);"></i>
                    Câu hỏi thường gặp (FAQ)
                </h2>
                <div style="display: grid; gap: 1rem;">
                    <div class="accordion-item">
                        <div class="accordion-header" onclick="toggleAccordion(this)">
                            <span>SLA là gì và tại sao quan trọng?</span>
                            <i class="fas fa-chevron-down accordion-icon"></i>
                        </div>
                        <div class="accordion-content">
                            <p>SLA (Service Level Agreement) là cam kết về thời gian giải quyết công việc. Mỗi mức độ ưu tiên có thời hạn SLA khác nhau:</p>
                            <ul style="padding-left: 1.5rem;">
                                <li><strong>Critical:</strong> 2 giờ</li>
                                <li><strong>High:</strong> 4 giờ</li>
                                <li><strong>Medium:</strong> 8 giờ</li>
                                <li><strong>Low:</strong> 24 giờ</li>
                            </ul>
                            <p>Vi phạm SLA ảnh hưởng đến đánh giá hiệu suất và chất lượng dịch vụ.</p>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header" onclick="toggleAccordion(this)">
                            <span>Làm thế nào để thay đổi người xử lý task?</span>
                            <i class="fas fa-chevron-down accordion-icon"></i>
                        </div>
                        <div class="accordion-content">
                            <p>Chỉ có Quản lý mới có quyền chuyển giao task:</p>
                            <ol style="padding-left: 1.5rem;">
                                <li>Quản lý vào chi tiết task</li>
                                <li>Nhấn nút "Reassign"</li>
                                <li>Chọn người xử lý mới</li>
                                <li>Nhập lý do chuyển giao</li>
                                <li>Hệ thống sẽ thông báo cho cả hai bên</li>
                            </ol>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header" onclick="toggleAccordion(this)">
                            <span>Tôi quên mật khẩu, phải làm sao?</span>
                            <i class="fas fa-chevron-down accordion-icon"></i>
                        </div>
                        <div class="accordion-content">
                            <p>Tại trang đăng nhập:</p>
                            <ol style="padding-left: 1.5rem;">
                                <li>Nhấn "Quên mật khẩu?"</li>
                                <li>Nhập email đăng ký</li>
                                <li>Kiểm tra email để nhận link reset mật khẩu</li>
                                <li>Hoặc liên hệ Hỗ trợ IT: support@hospital.vn hoặc ext. 1234</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact Support -->
            <div id="contact" class="card">
                <h2 style="margin-bottom: 1.5rem;">
                    <i class="fas fa-headset" style="color: var(--info-color);"></i>
                    Liên hệ Hỗ trợ
                </h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem;">
                    <div style="padding: 1.5rem; background: var(--gray-50); border-radius: 8px; text-align: center;">
                        <i class="fas fa-phone" style="font-size: 2rem; color: var(--primary-color); margin-bottom: 1rem;"></i>
                        <h4 style="margin-bottom: 0.5rem;">Hotline</h4>
                        <p style="color: var(--gray-600); margin-bottom: 0.5rem;">024.1234.5678</p>
                        <p style="font-size: 0.875rem; color: var(--gray-500);">8:00 - 17:00 (T2-T6)</p>
                    </div>
                    
                    <div style="padding: 1.5rem; background: var(--gray-50); border-radius: 8px; text-align: center;">
                        <i class="fas fa-comments" style="font-size: 2rem; color: var(--warning-color); margin-bottom: 1rem;"></i>
                        <h4 style="margin-bottom: 0.5rem;">Live Chat</h4>
                        <p style="color: var(--gray-600); margin-bottom: 0.5rem;">Trò chuyện trực tiếp</p>
                        <button class="btn btn-primary btn-sm">Bắt đầu chat</button>
                    </div>
                </div>
            </div>
        </div>
        </main>
    </div>

    <style>
        .accordion-item {
            border: 1px solid var(--border-color);
            border-radius: 8px;
            overflow: hidden;
        }

        .accordion-header {
            padding: 1rem 1.5rem;
            background: var(--gray-50);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 1rem;
            transition: background 0.2s;
        }

        .accordion-header:hover {
            background: var(--gray-100);
        }

        .accordion-header span {
            flex: 1;
            font-weight: 600;
        }

        .accordion-icon {
            transition: transform 0.3s;
        }

        .accordion-item.active .accordion-icon {
            transform: rotate(180deg);
        }

        .accordion-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out;
            padding: 0 1.5rem;
        }

        .accordion-item.active .accordion-content {
            max-height: 1000px;
            padding: 1rem 1.5rem;
            transition: max-height 0.5s ease-in;
        }
    </style>

    <script>
        function toggleAccordion(header) {
            const item = header.parentElement;
            const isActive = item.classList.contains('active');
            
            // Close all accordion items
            document.querySelectorAll('.accordion-item').forEach(i => {
                i.classList.remove('active');
            });
            
            // Open clicked item if it wasn't active
            if (!isActive) {
                item.classList.add('active');
            }
        }
    </script>
</body>
</html>
